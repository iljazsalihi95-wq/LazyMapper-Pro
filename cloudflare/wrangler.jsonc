{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lazymapper-pro",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 120, "period": 60}}],
  "observability": {"enabled": false},
  "vars": {
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "ADMIN_EMAILS": "",
    "ANALYZER_ORIGIN": "",
    "PORTAL_ORIGINS": "",
    "GAS_URL": "https://script.google.com/macros/s/AKfycbzkIAcq1rqGz3miDPsVS728dESNpBoNjXui_bUOofJMvDed2d73CdE5mHgkECPvuN7wWQ/exec"
  }
}
